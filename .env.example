# Database
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=finance
KEYCLOAK_CLIENT_ID=finance-web
KEYCLOAK_CLIENT_SECRET=dev-secret

# AI Router (9Router)
AI_ROUTER_URL=
AI_ROUTER_API_KEY=

# Services
API_PORT=3031
BFF_PORT=3032
AI_MS_PORT=3033
BANKING_MS_PORT=3034
API_URL=http://localhost:3031
AI_MS_URL=http://localhost:3033
BANKING_MS_URL=http://localhost:3034
TRANSACTIONS_MS_URL=http://localhost:3031

# Pluggy (feature 006, banking-ms)
PLUGGY_API_BASE_URL=https://api.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
BANKING_MS_KEYCLOAK_CLIENT_ID=banking-ms
BANKING_MS_KEYCLOAK_CLIENT_SECRET=dev-secret

# Web
# BFF acessado via proxy reverso do Next (mesma origem): /bff/* -> BFF.
# Relativo, evita CORS e cookie cross-subdomínio. Só troque se apontar direto pro BFF.
NEXT_PUBLIC_BFF_URL=/bff
# Alvo interno do proxy (server-side). Dev: BFF direto. Docker: http://bff:3032.
BFF_INTERNAL_URL=http://localhost:3032
NEXT_PUBLIC_PLUGGY_INCLUDE_SANDBOX=true

# BFF auth (feature 001)
SESSION_SECRET=change-me-to-a-random-string-with-32-chars
# URL PÚBLICA do BFF vista pelo browser = origem do web + /bff (proxy reverso).
# O redirect_uri do OAuth vira ${BFF_PUBLIC_URL}/auth/callback, então o Set-Cookie
# do callback cai na origem do web. Prod: https://calculaai.jonatahofmann.dev/bff
BFF_PUBLIC_URL=http://localhost:3030/bff
WEB_URL=http://localhost:3030
# Domínio do cookie de sessão. Com o proxy reverso (/bff) web e bff são a MESMA
# origem, então deixe vazio (cookie host-only já basta). Só use o domínio pai se
# expuser o BFF direto em subdomínio separado, sem proxy:
# SESSION_COOKIE_DOMAIN=.jonatahofmann.dev
SESSION_COOKIE_DOMAIN=
