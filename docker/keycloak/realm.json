      }
    ]
  },
  "defaultRoles": ["user"],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "test@calcula-ai.local",
      "email": "test@calcula-ai.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "test1234", "temporary": false }],
      "realmRoles": ["user"]
    },
    {
      "username": "service-account-calcula-ai-api",
      "enabled": true,
      "serviceAccountClientId": "calcula-ai-api",
      "realmRoles": ["svc-transactions-import"]
