      "redirectUris": ["http://localhost:3030/bff/auth/callback"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3030/*",
        "pkce.code.challenge.method": "S256"
      },
      "protocol": "openid-connect"
    },
    {
      "clientId": "calcula-ai-api",
      "publicClient": false,
      "secret": "dev-secret-svc-transactions-import",
