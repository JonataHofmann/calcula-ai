{
  "realm": "calcula-ai",
  "enabled": true,
  "loginTheme": "calcula-ai",
  "registrationAllowed": true,
  "clients": [
    {
      "clientId": "calcula-ai-web",
      "publicClient": false,
      "secret": "dev-secret",
