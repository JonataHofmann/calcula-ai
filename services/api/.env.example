# ── api (API-MS) ──────────────────────────────────────────────────────────────
# Monólito modular do domínio financeiro. Porta padrão 3031.

NODE_ENV=development
API_PORT=3031

# CORS: origens permitidas, separadas por vírgula (ex.: quem chama a API direto).
CORS_ORIGINS=http://localhost:3032

# Banco (schema `public`). As migrations rodam no boot (migrationsRun).
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance
# Banco SÓ para os testes de integração (int.spec). NUNCA aponte para o DATABASE_URL
# de dev: as suites usam dropSchema/synchronize e apagam os dados.
TEST_DATABASE_URL=postgresql://finance:finance@localhost:5432/finance_test

# Keycloak (validação do JWT Bearer — chaves públicas do realm).
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=calcula-ai

# Logs. pretty (default, todos ambientes) ou json (agregadores). Nível: info/debug/…
LOG_FORMAT=pretty
LOG_LEVEL=info
