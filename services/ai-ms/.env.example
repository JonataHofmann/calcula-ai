# ── ai-ms (AI microservice) ───────────────────────────────────────────────────
# Extração de fatura via LLM (9Router). Porta padrão 3033.

NODE_ENV=development
AI_MS_PORT=3033

# CORS: quem chama o ai-ms direto (normalmente só o bff).
CORS_ORIGINS=http://localhost:3032

# Keycloak (validação do JWT Bearer repassado pelo bff).
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=calcula-ai

# Provedor de IA (9Router / gateway compatível com OpenAI).
AI_ROUTER_URL=http://localhost:20128/v1
AI_ROUTER_API_KEY=
# Modelo usado na extração de fatura.
AI_INVOICE_MODEL=gemini/gemini-3.5-flash-lite

# Logs. pretty (default, todos ambientes) ou json (agregadores).
LOG_FORMAT=pretty
LOG_LEVEL=info
