# ── banking-ms (Banking Integration MS) ───────────────────────────────────────
# Conexões bancárias via Pluggy + sync de transações para a API. Porta padrão 3034.

NODE_ENV=development
BANKING_MS_PORT=3034

# CORS: quem chama o banking-ms direto (bff) + webhooks.
CORS_ORIGINS=http://localhost:3032

# Banco (schema `banking`). Migrations rodam no boot.
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance

# Keycloak. Valida o JWT do usuário (URL/REALM) e obtém token client-credentials
# (client-id/secret) para importar transações na API máquina-a-máquina.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=calcula-ai
BANKING_MS_KEYCLOAK_CLIENT_ID=calcula-ai-api
BANKING_MS_KEYCLOAK_CLIENT_SECRET=dev-secret

# Alvo do importador de transações (API-MS).
TRANSACTIONS_MS_URL=http://localhost:3031

# Pluggy (feature 006).
PLUGGY_API_BASE_URL=https://api.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=

# Logs. pretty (default, todos ambientes) ou json (agregadores).
LOG_FORMAT=pretty
LOG_LEVEL=info
