# ── bff (Backend-for-Frontend) ────────────────────────────────────────────────
# OAuth/OIDC + sessão + proxy para os microserviços. Porta padrão 3032.

NODE_ENV=development
BFF_PORT=3032

# CORS: origem do web. Com o proxy reverso (/bff) web e bff são a mesma origem.
CORS_ORIGINS=http://localhost:3030

# Banco (schema `bff`, tabela de sessões). Migrations rodam no boot.
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance

# Keycloak (fluxo OIDC — client confidencial).
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=calcula-ai
KEYCLOAK_CLIENT_ID=calcula-ai-web
KEYCLOAK_CLIENT_SECRET=dev-secret

# Sessão. Segredo HMAC do cookie (mín. 32 chars) — gere um aleatório em prod.
SESSION_SECRET=change-me-to-a-random-string-with-32-chars
# Domínio do cookie. Com o proxy reverso deixe vazio (host-only já basta).
SESSION_COOKIE_DOMAIN=

# URL PÚBLICA do bff vista pelo browser = origem do web + /bff (proxy reverso).
# redirect_uri do OAuth = ${BFF_PUBLIC_URL}/auth/callback → Set-Cookie na origem do web.
BFF_PUBLIC_URL=http://localhost:3030/bff
WEB_URL=http://localhost:3030

# Upstream dos microserviços (proxy interno do bff).
API_URL=http://localhost:3031
AI_MS_URL=http://localhost:3033
BANKING_MS_URL=http://localhost:3034

# Logs. pretty (default, todos ambientes) ou json (agregadores).
LOG_FORMAT=pretty
LOG_LEVEL=info
