# ── web (Next.js) ─────────────────────────────────────────────────────────────
# App do usuário. Porta padrão 3030.

NODE_ENV=development
PORT=3030

# BFF acessado via proxy reverso do Next (mesma origem): /bff/* -> BFF.
# Relativo, evita CORS e cookie cross-subdomínio. Só troque se apontar direto pro BFF.
# OBS: NEXT_PUBLIC_* é embutido no bundle no BUILD (não muda em runtime).
NEXT_PUBLIC_BFF_URL=/bff
# Alvo interno do proxy (server-side, rewrites do next.config).
# Dev: BFF direto. Docker: http://bff:3032.
BFF_INTERNAL_URL=http://localhost:3032

# Pluggy: exibe instituições sandbox no widget de conexão.
NEXT_PUBLIC_PLUGGY_INCLUDE_SANDBOX=true
